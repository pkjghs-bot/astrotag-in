# Astrotag Environment Configuration Template
# Duplicate this file as .env for local development
# NEVER commit .env with real credentials to source control!

# Gemini AI API Key (Required for AI Vedic Analyst)
# Obtain from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (Comma-separated list of origins)
# In production, restrict strictly to your registered domains:
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
